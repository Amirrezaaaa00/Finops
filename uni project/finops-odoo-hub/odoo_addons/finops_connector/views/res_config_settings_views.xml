<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_finops" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.finops</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="FinOps" name="finops_connector">
                    <block title="FinOps Gateway">
                        <setting string="Gateway URL" help="Address of the FinOps Gateway service that normalizes OpenCost data.">
                            <field name="finops_gateway_url" placeholder="http://finops-gateway:8000"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
