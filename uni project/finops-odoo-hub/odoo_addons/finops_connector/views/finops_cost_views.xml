<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_finops_cost_list" model="ir.ui.view">
        <field name="name">finops.cost.record.list</field>
        <field name="model">finops.cost.record</field>
        <field name="arch" type="xml">
            <list string="FinOps Costs" create="false" delete="false" decoration-danger="cost &gt; 100">
                <field name="usage_date"/>
                <field name="project_name"/>
                <field name="department"/>
                <field name="provider"/>
                <field name="service"/>
                <field name="resource" optional="hide"/>
                <field name="environment" optional="hide"/>
                <field name="cost" sum="Total"/>
                <field name="currency_code"/>
                <field name="project_id" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_finops_cost_form" model="ir.ui.view">
        <field name="name">finops.cost.record.form</field>
        <field name="model">finops.cost.record</field>
        <field name="arch" type="xml">
            <form string="FinOps Cost">
                <sheet>
                    <group>
                        <group>
                            <field name="usage_date"/>
                            <field name="provider"/>
                            <field name="account_id"/>
                            <field name="service"/>
                        </group>
                        <group>
                            <field name="project_name"/>
                            <field name="department"/>
                            <field name="project_id"/>
                            <field name="cost"/>
                            <field name="currency_code"/>
                        </group>
                    </group>
                    <group>
                        <field name="resource"/>
                        <field name="category"/>
                        <field name="environment"/>
                        <field name="source"/>
                        <field name="external_id"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_finops_cost_pivot" model="ir.ui.view">
        <field name="name">finops.cost.record.pivot</field>
        <field name="model">finops.cost.record</field>
        <field name="arch" type="xml">
            <pivot string="FinOps Cost Analysis">
                <field name="project_name" type="row"/>
                <field name="service" type="col"/>
                <field name="cost" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="view_finops_cost_graph" model="ir.ui.view">
        <field name="name">finops.cost.record.graph</field>
        <field name="model">finops.cost.record</field>
        <field name="arch" type="xml">
            <graph string="FinOps Cost Trend" type="bar">
                <field name="usage_date" interval="day"/>
                <field name="cost" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="action_finops_costs" model="ir.actions.act_window">
        <field name="name">FinOps Costs</field>
        <field name="res_model">finops.cost.record</field>
        <field name="view_mode">list,pivot,graph,form</field>
    </record>

    <record id="server_action_finops_sync" model="ir.actions.server">
        <field name="name">Sync FinOps Now</field>
        <field name="model_id" ref="model_finops_cost_record"/>
        <field name="state">code</field>
        <field name="code">action = model.action_sync_now()</field>
    </record>

    <menuitem id="menu_finops_root" name="FinOps" sequence="70"/>
    <menuitem id="menu_finops_costs" name="Cloud Costs" parent="menu_finops_root" action="action_finops_costs" sequence="10"/>
    <menuitem id="menu_finops_sync" name="Sync Now" parent="menu_finops_root" action="server_action_finops_sync" sequence="20"/>
</odoo>
